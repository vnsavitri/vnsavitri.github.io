---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  pathname?: string;
}

const {
  title = "Vivid Savitri-Hampton",
  description = "Vivid Savitri-Hampton, Sydney. Applied AI engineer building multi-agent systems, local AI operating systems, and agent safety envelopes that run in production.",
  pathname = "",
} = Astro.props;

const canonicalURL = new URL(pathname, Astro.site).toString();
const ogImage = new URL("/og.png", Astro.site).toString();

// Person schema. Lets AI search engines answer "who is this / where are they
// based" from structured data instead of inferring it from the prose.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Vivid Savitri-Hampton",
  jobTitle: "Applied AI engineer",
  url: "https://veryvivid.xyz/",
  image: new URL("/vivid-portrait.webp", Astro.site).toString(),
  description:
    "Applied AI engineer in Sydney. Builds multi-agent systems, local AI operating systems, and agent safety envelopes.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Sydney",
    addressRegion: "NSW",
    addressCountry: "AU",
  },
  worksFor: { "@type": "Organization", name: "Breville Group" },
  knowsAbout: [
    "Agentic AI systems",
    "Multi-agent architectures",
    "Model Context Protocol",
    "Local AI operating systems",
    "Local model inference",
    "AI safety envelopes",
    "Provenance-aware retrieval",
    "Human-AI interaction",
    "AI product management",
  ],
  knowsLanguage: ["English", "French", "Mandarin"],
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Duke University, Pratt School of Engineering" },
    { "@type": "CollegeOrUniversity", name: "Steinbeis Hochschule Berlin" },
  ],
  award: [
    "Red Dot Award 2022, Best of the Best: Breville Barista Express Impress BES876",
    "SCA Award 2022: Breville Barista Express Impress BES876",
    "Good Design Award 2022: Breville Joule Oven Air Pro",
    "Red Dot Award 2020: Breville Polyscience HydroPro SousVide",
    "Red Dot Award 2020: Breville Nespresso Creatista Pro",
    "IDSA 2019, Bronze: Breville Smart Oven AirFry",
    "NASA SpaceApps 2017, 1st Place Australia",
    "NASA SpaceApps 2016, 1st Place Australia",
  ],
  sameAs: [
    "https://www.linkedin.com/in/vnsavitri/",
    "https://github.com/vnsavitri",
    "https://www.vnsavitri.com/",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Vivid Savitri-Hampton" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Vivid Savitri-Hampton. I build AI systems that take safety as seriously as capability."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <meta name="theme-color" content="#f0f6f6" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <script is:inline>
      if (window.location.hostname === "vnsavitri.github.io") {
        window.location.replace(
          `https://veryvivid.xyz${window.location.pathname}${window.location.search}${window.location.hash}`,
        );
      }
    </script>
  </head>

  <body>
    <header class="site-header container-wide">
      <a href="/" class="site-logo">Vivid Savitri-Hampton</a>
      <nav class="site-nav" id="site-nav">
        <a href="/">Work</a>
        <a href="/about">About</a>
        <a href="https://www.vnsavitri.com/" target="_blank" rel="noopener">Site</a>
        <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub</a>
        <a href="/#archives">Archive</a>
      </nav>
      <button class="nav-toggle" id="nav-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer container-wide">
      <div class="footer-inner">
        <div class="small-caps">Sydney, Australia · {new Date().getFullYear()}</div>
        <nav class="footer-links">
          <a href="https://www.vnsavitri.com/" target="_blank" rel="noopener">vnsavitri.com</a>
          <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/vnsavitri/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:vnsavitri@protonmail.ch">Email</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const nav = document.getElementById('site-nav') as HTMLElement;

  function openNav() {
    nav.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close navigation');
  }

  function closeNav() {
    nav.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open navigation');
  }

  toggle.addEventListener('click', () => {
    nav.classList.contains('is-open') ? closeNav() : openNav();
  });

  nav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeNav));

  document.addEventListener('click', (e) => {
    if (e.target instanceof Node && !toggle.contains(e.target) && !nav.contains(e.target)) {
      closeNav();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNav();
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2.25rem;
    padding-bottom: 2.25rem;
    position: relative;
  }

  .site-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    font-optical-sizing: auto;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }

  .site-nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.875rem;
    font-family: var(--font-body);
  }

  .site-nav a {
    text-decoration: none;
    color: var(--color-ink-soft);
    transition: color 0.15s ease;
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  /* Footer */
  .site-footer {
    padding-top: 3rem;
    padding-bottom: 3rem;
    margin-top: 5rem;
    border-top: 1px solid var(--color-rule);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.875rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--color-ink-soft);
  }

  /* Hamburger button: hidden on desktop */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .nav-toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* ─── Responsive ─── */

  /* Tablet and up: footer goes side-by-side */
  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }
  }

  /* Mobile: collapse nav into hamburger */
  @media (max-width: 600px) {
    .site-header {
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--color-cream);
      border-bottom: 1px solid var(--color-rule);
      padding: 0.5rem clamp(1.25rem, 8vw, 8rem) 1.25rem;
      gap: 0;
      z-index: 100;
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav a {
      padding: 0.75rem 0;
      font-size: 0.9rem;
      border-bottom: 1px solid color-mix(in srgb, var(--color-rule) 60%, transparent);
    }

    .site-nav a:last-child {
      border-bottom: none;
    }
  }
</style>
