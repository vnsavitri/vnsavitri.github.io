---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Per-project structured data, built from frontmatter that already exists.
// Gives AI search engines something to cite beyond the prose.
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.data.title,
  description: project.data.hook,
  codeRepository: project.data.repo,
  programmingLanguage: project.data.tech,
  url: new URL(`/projects/${project.data.slug}/`, Astro.site).toString(),
  author: {
    "@type": "Person",
    name: "Vivid Savitri-Hampton",
    url: "https://veryvivid.xyz/",
  },
  ...(project.data.live ? { sameAs: [project.data.live] } : {}),
};
---

<Layout
  title={`${project.data.title} | Vivid Savitri-Hampton`}
  description={project.data.hook}
  pathname={`/projects/${project.data.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  <article class="container-prose pt-8 pb-24" style="max-width: 1200px;">
    <p class="small-caps mb-8">
      <a href="/" style="text-decoration: none; color: var(--color-ink-muted);">← Work</a>
    </p>

    <h1 class="mb-6">{project.data.title}</h1>

    <p class="lede mb-8">{project.data.hook}</p>

    <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; align-items: center;">
      {project.data.status.map((s: string, i: number) => (
        <span class={`pill ${i === 0 && project.data.accent ? "pill-accent" : ""}`}>{s}</span>
      ))}
      {project.data.stars && <span class="pill">★ {project.data.stars}</span>}
    </div>

    <div class="tech-tag" style="margin-bottom: 3rem;">{project.data.tech.join(" · ")}</div>

    <div style="border-top: 1px solid var(--color-rule); margin: 2rem 0;"></div>

    <div class="prose-body">
      <Content />
    </div>

    <div style="border-top: 1px solid var(--color-rule); margin: 3rem 0;"></div>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <a
        href={project.data.repo}
        target="_blank"
        rel="noopener"
        style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; text-decoration: none;"
      >
        View repository →
      </a>
      {project.data.live && (
        <a
          href={project.data.live}
          target="_blank"
          rel="noopener"
          style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; text-decoration: none;"
        >
          Live: {project.data.live.replace(/^https?:\/\//, "")} →
        </a>
      )}
      {project.data.demo && (
        <a
          href={project.data.demo}
          target="_blank"
          rel="noopener"
          style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; text-decoration: none;"
        >
          Watch demo →
        </a>
      )}
    </div>
  </article>
</Layout>
