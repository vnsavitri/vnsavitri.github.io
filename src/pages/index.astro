---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

---

<Layout title="Vivid Savitri-Hampton | Applied AI Product Engineer">
  <!-- Hero -->
  <section class="container-wide hero-section">
    <h1 class="hero-heading">
      I build AI systems that take<br class="hero-br" />
      <span style="color: var(--color-accent);">safety</span> as seriously as
      <span style="color: var(--color-accent);">capability.</span>
    </h1>

    <p class="lede">
      Most AI demos look impressive but rarely survive contact with a real
      workplace: messy data, unclear ownership, and people who have better things
      to do than babysit an agent. This is my sweet spot: scaling demos into
      product that survives the messiness of enterprise environments.
    </p>

    <p class="lede">
      I work between product leadership and applied AI engineering, turning
      ambiguous problems into AI systems people can actually use. That includes
      agent workflows, harness engineering, evaluation harnesses and local-first
      products. One end of that range is a production system helping global GTM
      teams search 235,000+ brand assets in natural language. The other end is
      smaller experiments that never leave my own machine.
    </p>

    <p class="lede-bio">
      Before building AI-native products became my full-time job, I built products
      across games, SaaS and hardware, including two startups that were acquired.
      Different industries, same instinct: find the part of the system that doesn't
      work for humans, then make it less stupid.
    </p>

    <p class="proof-strip">
      235K+ assets in production · Two startup exits · Agent systems · MCP · Evals · Enterprise AI
    </p>

    <nav class="hero-links">
      <a href="#work">View flagship systems ↓</a>
      <a href="https://www.vnsavitri.com/" target="_blank" rel="noopener">vnsavitri.com →</a>
      <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
      <a href="https://www.linkedin.com/in/vnsavitri/" target="_blank" rel="noopener">LinkedIn →</a>
    </nav>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <!-- Projects -->
  <section class="container-wide projects-section" id="work">
    <div class="projects-header">
      <h2>Featured work</h2>
      <span class="small-caps">Seven projects</span>
    </div>

    <ol class="projects-list">
      {projects.map((project, idx) => (
        <li class="project-item">
          {idx > 0 && <div class="project-divider"></div>}
          <a href={`/projects/${project.data.slug}/`} class="project-link">
            <article class="project-card">
              <div class="project-num" aria-hidden="true">0{idx + 1}</div>

              <div class="project-body">
                <h3 class="project-title">{project.data.title}</h3>

                <p class="project-hook">{project.data.hook}</p>

                <div class="project-pills">
                  {project.data.status.map((s: string, i: number) => (
                    <span class={`pill ${i === 0 && project.data.accent ? "pill-accent" : ""}`}>{s}</span>
                  ))}
                  {project.data.stars && (
                    <span class="pill">★ {project.data.stars}</span>
                  )}
                </div>

                <div class="tech-tag">{project.data.tech.join(" · ")}</div>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ol>

    <p class="more-link">
      More on <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
    </p>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide speaking-section">
    <div class="speaking-header">
      <h2>Speaking</h2>
      <span class="small-caps">Two engagements</span>
    </div>

    <ol class="speaking-list">
      <li class="speaking-item">
        <a href="https://vercel.com/blog/vercel-ship-2026-recap" target="_blank" rel="noopener" class="speaking-link">
          <article class="speaking-card">
            <img
              src="/vercel-ship-syd-2026.webp"
              alt="Panel on stage at Vercel Ship Sydney 2026: The AI org, people, structure, and the decisions that matter"
              class="speaking-thumb"
              width="1200"
              height="673"
              loading="lazy"
              decoding="async"
            />
            <div class="speaking-body">
              <div class="speaking-meta small-caps">Vercel Ship Sydney · 2026</div>
              <h3 class="speaking-title">The AI org: people, structure, and the decisions that matter</h3>
              <p class="speaking-hook">
                Panel with Tom Glover (MYOB) and Kristina Ryan (Go1), moderated by JJ Lecocq (Vercel).
                The interesting part was the cross-industry contrast: legacy cleanup, shadow-AI sprawl,
                and a modern stack running inside a 94-year-old hardware company, all wrestling with the
                same tension between moving fast and building foundations that hold.
              </p>
              <span class="speaking-cta">Read the recap →</span>
            </div>
          </article>
        </a>
      </li>
      <li class="speaking-item">
        <div class="speaking-divider"></div>
        <a href="https://www.clutchevents.co/events/sydney-enterprise-ai-and-automation-summit-2026" target="_blank" rel="noopener" class="speaking-link">
          <article class="speaking-card">
            <img
              src="/clutch-enterprise-ai-summit-2026.webp"
              alt="Speaker card for Vivid Savitri at the Sydney Enterprise AI and Automation Summit 2026"
              class="speaking-thumb"
              width="1200"
              height="667"
              loading="lazy"
              decoding="async"
            />
            <div class="speaking-body">
              <div class="speaking-meta small-caps">Sydney Enterprise AI and Automation Summit · 2026</div>
              <h3 class="speaking-title">Is your AI program hitting the mark?</h3>
              <p class="speaking-hook">
                Panel discussion on enterprise AI program evaluation, hosted by Clutch Events in Sydney.
              </p>
              <span class="speaking-cta">Event details →</span>
            </div>
          </article>
        </a>
      </li>
    </ol>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide writing-section">
    <div class="writing-header">
      <h2>Writing</h2>
      <span class="small-caps">One piece</span>
    </div>

    <ol class="writing-list">
      <li class="writing-item">
        <a href="https://www.linkedin.com/pulse/ai-watermarking-new-scarlet-letter-vivid-n-savitri-npzpc" target="_blank" rel="noopener" class="writing-link">
          <article class="writing-card">
            <div class="writing-meta small-caps">LinkedIn · 21 August 2026</div>
            <h3 class="writing-title">AI watermarking is the new scarlet letter</h3>
            <p class="writing-hook">
              Every major lab is shipping watermarks as a transparency win. What actually
              happens: a mark that reads as cheating no matter why the AI was used,
              landing hardest on people with dyslexia, or other disabilities, and
              neurodivergent writers who rely on it to write at all. Spell-check and academic fraud getting flattened into the
              same signal is the actual problem.
            </p>
            <span class="writing-cta">Read the article →</span>
          </article>
        </a>
      </li>
    </ol>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide build-section">
    <div class="build-header">
      <h2>How I build</h2>
      <span class="small-caps">Five principles</span>
    </div>

    <div class="prose-body">
      <p>
        I use AI where it earns its place. Half the fun is figuring out whether it's
        actually helping or just slowing me down, especially the moment it starts
        producing slop. Ain't nobody got time to babysit a dumb agent.
      </p>

      <p>
        <strong>Open-source and local model</strong>: I default to open weights and local
        models first. For personal works that's LM Studio, Unsloth or DeepSeek Harness
        running Kimi, Qwen and friends; at work the stack is closed, mostly OpenAI and
        Anthropic, and that comes with its own tradeoffs. The call depends on privacy,
        cost, capability and the job in front of me.
      </p>

      <p>
        <strong>Harness engineering</strong>: Most of my time goes into the harness around
        agent workflows: explicit state, scoped delegation, handoffs that actually carry
        context, and memory that doesn't turn into a junk drawer. This is the actual work
        behind CoworkOS (Anthropic) and WorkspaceOS (OpenAI) that I created for people to
        use at work (customised and deployed for Finance, Legal, IP, NPD, Test Kitchens
        and GTM teams).
      </p>

      <p>
        I turn messy real-world work into AI products people can understand, trust,
        and use.
      </p>

      <p>
        <strong>Evaluation, evidence and safety</strong>: I test what a system actually
        does, keep provenance where it matters, and put review gates around decisions that
        have real consequences. Same discipline behind <a href="/projects/vai-sante-os/">chain-of-custody
        memory</a> and <a href="/projects/vivid-alpaca/">execution guardrails on live trading</a>.
      </p>

      <p>
        On the product side, I move from problem framing and prototype to a working
        product, with enough technical depth to make good calls along the way.
      </p>
    </div>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <!-- Contact -->
  <section class="container-wide contact-section" id="contact">
    <div class="contact-header">
      <p class="small-caps contact-kicker">Contact</p>
      <h2>Get in touch</h2>
    </div>

    <p class="contact-lede">
      I'm interested in frontier and applied AI roles where product judgement and
      hands-on building belong in the same job. If you're working on agent systems,
      evaluations, enterprise AI or trustworthy deployment, I'd like to hear what
      you're trying to make work.
    </p>

    <p class="contact-links">
      <a href="mailto:hello@veryvivid.xyz" class="contact-email">hello (at) veryvivid.xyz</a>
      <a href="https://www.linkedin.com/in/vnsavitri/" target="_blank" rel="noopener">LinkedIn →</a>
      <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
    </p>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  /* Hero h1 overrides the global h1: bigger, but still controlled */
  .hero-heading {
    font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.75rem;
  }

  /* Biographical line under the lede. Smaller and quieter so the technical
     sentences above it stay the thing you read first. */
  .lede-bio {
    font-size: 0.95rem;
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-ink-muted);
    max-width: 72ch;
    margin-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .lede + .lede {
    margin-top: 1rem;
  }

  /* Proof strip: verified metrics only, kept quiet so the copy stays the hero */
  .proof-strip {
    max-width: 72ch;
    margin-bottom: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .hero-links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    color: var(--color-ink-soft);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Projects list */
  .projects-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .projects-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-divider {
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  .project-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Desktop: number on left, content on right */
  .project-card {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  .project-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-rule);
    line-height: 1;
    font-optical-sizing: auto;
    transition: color 0.2s ease;
    user-select: none;
    padding-top: 0.2rem;
  }

  .project-link:hover .project-num {
    color: color-mix(in srgb, var(--color-accent) 30%, var(--color-rule));
  }

  .project-body {
    padding-top: 0.2rem;
  }

  .project-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .project-link:hover .project-title {
    color: var(--color-accent);
  }

  .project-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 70ch;
    margin-bottom: 1rem;
  }

  .project-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
    align-items: center;
  }

  .more-link {
    margin-top: 4rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  /* ─── Mobile ─── */
  @media (max-width: 600px) {
    .hero-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .hero-br {
      display: none; /* let heading reflow naturally on small screens */
    }

    .hero-links {
      gap: 1rem;
      font-size: 0.8rem;
    }

    .projects-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .projects-header {
      margin-bottom: 2rem;
    }

    /* Stack: number above title on mobile */
    .project-card {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .project-num {
      font-size: 1rem;
      letter-spacing: 0.1em;
      color: var(--color-ink-muted);
      font-weight: 600;
      font-optical-sizing: auto;
      /* Reset to small-caps style on mobile: decorative number becomes tiny label */
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      padding-top: 0;
    }

    .project-divider {
      margin: 2rem 0;
    }
  }

  /* Contact */
  .contact-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .contact-header {
    margin-bottom: 2.5rem;
  }

  .contact-kicker {
    margin-bottom: 0.75rem;
  }

  .contact-lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 62ch;
    margin-bottom: 2rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: baseline;
    font-size: 0.95rem;
  }

  .contact-links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    color: var(--color-ink-soft);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .contact-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .contact-email {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-ink) !important;
  }

  @media (max-width: 600px) {
    .contact-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .contact-header {
      margin-bottom: 2rem;
    }

    .contact-links {
      gap: 1rem;
      font-size: 0.875rem;
    }
  }

  /* Speaking */
  .speaking-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .speaking-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .speaking-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .speaking-divider {
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  .speaking-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .speaking-card {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  .speaking-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .speaking-body {
    padding-top: 0.2rem;
  }

  .speaking-meta {
    margin-bottom: 0.6rem;
    color: var(--color-ink-muted);
  }

  .speaking-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .speaking-link:hover .speaking-title {
    color: var(--color-accent);
  }

  .speaking-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 65ch;
    margin-bottom: 0.75rem;
  }

  .speaking-cta {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .speaking-link:hover .speaking-cta {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .speaking-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .speaking-header {
      margin-bottom: 2rem;
    }

    .speaking-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .speaking-divider {
      margin: 2rem 0;
    }
  }

  /* Writing */
  .writing-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .writing-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .writing-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .writing-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .writing-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .writing-link:hover .writing-title {
    color: var(--color-accent);
  }

  .writing-meta {
    margin-bottom: 0.6rem;
    color: var(--color-ink-muted);
  }

  .writing-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 70ch;
    margin-bottom: 0.75rem;
  }

  .writing-cta {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .writing-link:hover .writing-cta {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .writing-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .writing-header {
      margin-bottom: 2rem;
    }
  }

  /* How I build */
  .build-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .build-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 640px) {
    .build-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .build-header {
      margin-bottom: 1.5rem;
    }
  }
</style>
