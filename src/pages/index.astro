---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const archives = [
  {
    title: "Designr.link",
    period: "2014–2018",
    kind: "Selected work",
    description: "Product, public-service, interactive and game design across teams, continents and formats.",
    href: "/archive/designr/index.html",
    variant: "designr",
  },
  {
    title: "Design Sans Frontières",
    period: "2009–2014",
    kind: "Personal archive",
    description: "Design, games, photography, wanderlust and beautifully geeky things from an earlier internet.",
    href: "/archive/design-sans-frontieres/index.html",
    variant: "sans-frontieres",
  },
  {
    title: "Berlin 3.0",
    period: "2012–2013",
    kind: "Field dispatches",
    description: "Thirty-two dispatches from Berlin School, travelling Berlin → Shanghai → Tokyo → New York.",
    href: "/archive/berlin-3/index.html",
    variant: "berlin",
  },
];

---

<Layout title="Vivid Savitri-Hampton | Applied AI Product Engineer">
  <!-- Hero -->
  <section class="container-wide hero-section">
    <p class="small-caps" style="margin-bottom: 1.75rem;">AI / Product / Sydney</p>

    <h1 class="hero-heading">
      I build AI systems that take<br class="hero-br" />
      <span style="color: var(--color-accent);">safety</span> as seriously as
      <span style="color: var(--color-accent);">capability.</span>
    </h1>

    <p class="lede">
      A few months ago I was asking my oncologist to point at my own brain MRI and
      tell me where to look, because the report might as well have been written in
      Klingon. So I built the tool I needed. That's pretty much how lots of things here
      get built: a problem I actually have, and no decent tool for it. Some of that work
      ships inside a 94-year-old hardware company, and others never leave my own machine.
    </p>

    <p class="lede-bio">
      Before any of that there were two startup exits in video games, one out of Shanghai and another while in Berlin, and a long stretch of living and working across twelve countries on four continents that eventually landed me in Sydney.
    </p>

    <nav class="hero-links">
      <a href="/about">About →</a>
      <a href="https://www.vnsavitri.com/" target="_blank" rel="noopener">vnsavitri.com →</a>
      <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
      <a href="https://www.linkedin.com/in/vnsavitri/" target="_blank" rel="noopener">LinkedIn →</a>
    </nav>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <!-- Projects -->
  <section class="container-wide projects-section">
    <div class="projects-header">
      <h2>Featured work</h2>
      <span class="small-caps">Seven projects</span>
    </div>

    <ol class="projects-list">
      {projects.map((project, idx) => (
        <li class="project-item">
          {idx > 0 && <div class="project-divider"></div>}
          <a href={`/projects/${project.data.slug}/`} class="project-link">
            <article class="project-card">
              <div class="project-num" aria-hidden="true">0{idx + 1}</div>

              <div class="project-body">
                <h3 class="project-title">{project.data.title}</h3>

                <p class="project-hook">{project.data.hook}</p>

                <div class="project-pills">
                  {project.data.status.map((s: string, i: number) => (
                    <span class={`pill ${i === 0 && project.data.accent ? "pill-accent" : ""}`}>{s}</span>
                  ))}
                  {project.data.stars && (
                    <span class="pill">★ {project.data.stars}</span>
                  )}
                </div>

                <div class="tech-tag">{project.data.tech.join(" · ")}</div>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ol>

    <p class="more-link">
      More on <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
    </p>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide speaking-section">
    <div class="speaking-header">
      <h2>Speaking</h2>
      <span class="small-caps">Two engagements</span>
    </div>

    <ol class="speaking-list">
      <li class="speaking-item">
        <a href="https://vercel.com/blog/vercel-ship-2026-recap" target="_blank" rel="noopener" class="speaking-link">
          <article class="speaking-card">
            <img
              src="/vercel-ship-syd-2026.webp"
              alt="Panel on stage at Vercel Ship Sydney 2026: The AI org, people, structure, and the decisions that matter"
              class="speaking-thumb"
              width="1200"
              height="673"
              loading="lazy"
              decoding="async"
            />
            <div class="speaking-body">
              <div class="speaking-meta small-caps">Vercel Ship Sydney · 2026</div>
              <h3 class="speaking-title">The AI org: people, structure, and the decisions that matter</h3>
              <p class="speaking-hook">
                Panel with Tom Glover (MYOB) and Kristina Ryan (Go1), moderated by JJ Lecocq (Vercel).
                The interesting part was the cross-industry contrast: legacy cleanup, shadow-AI sprawl,
                and a modern stack running inside a 94-year-old hardware company, all wrestling with the
                same tension between moving fast and building foundations that hold.
              </p>
              <span class="speaking-cta">Read the recap →</span>
            </div>
          </article>
        </a>
      </li>
      <li class="speaking-item">
        <div class="speaking-divider"></div>
        <a href="https://www.clutchevents.co/events/sydney-enterprise-ai-and-automation-summit-2026" target="_blank" rel="noopener" class="speaking-link">
          <article class="speaking-card">
            <img
              src="/clutch-enterprise-ai-summit-2026.webp"
              alt="Speaker card for Vivid Savitri at the Sydney Enterprise AI and Automation Summit 2026"
              class="speaking-thumb"
              width="1200"
              height="667"
              loading="lazy"
              decoding="async"
            />
            <div class="speaking-body">
              <div class="speaking-meta small-caps">Sydney Enterprise AI and Automation Summit · 2026</div>
              <h3 class="speaking-title">Is your AI program hitting the mark?</h3>
              <p class="speaking-hook">
                Panel discussion on enterprise AI program evaluation, hosted by Clutch Events in Sydney.
              </p>
              <span class="speaking-cta">Event details →</span>
            </div>
          </article>
        </a>
      </li>
    </ol>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide writing-section">
    <div class="writing-header">
      <h2>Writing</h2>
      <span class="small-caps">One piece</span>
    </div>

    <ol class="writing-list">
      <li class="writing-item">
        <a href="https://www.linkedin.com/pulse/ai-watermarking-new-scarlet-letter-vivid-n-savitri-npzpc" target="_blank" rel="noopener" class="writing-link">
          <article class="writing-card">
            <div class="writing-meta small-caps">LinkedIn · 21 August 2026</div>
            <h3 class="writing-title">AI watermarking is the new scarlet letter</h3>
            <p class="writing-hook">
              Every major lab is shipping watermarks as a transparency win. What actually
              happens: a mark that reads as cheating no matter why the AI was used,
              landing hardest on disabled and neurodivergent writers who rely on it to
              write at all. Spell-check and academic fraud getting flattened into the
              same signal is the actual problem.
            </p>
            <span class="writing-cta">Read the article →</span>
          </article>
        </a>
      </li>
    </ol>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide build-section">
    <div class="build-header">
      <h2>How I build</h2>
      <span class="small-caps">Five principles</span>
    </div>

    <div class="prose-body">
      <p>
        I use AI where it earns its place. Half the fun is figuring out whether it's
        actually helping or just slowing me down, especially the moment it starts
        producing slop. Ain't nobody got time to babysit a dumb agent.
      </p>

      <p>
        <strong>Open-source and local model</strong>: I default to open weights and local
        models first. For personal works that's LM Studio, Unsloth or DeepSeek Harness
        running Kimi, Qwen and friends; at work the stack is closed, mostly OpenAI and
        Anthropic, and that comes with its own tradeoffs. The call depends on privacy,
        cost, capability and the job in front of me.
      </p>

      <p>
        <strong>Harness engineering</strong>: Most of my time goes into the harness around
        agent workflows: explicit state, scoped delegation, handoffs that actually carry
        context, and memory that doesn't turn into a junk drawer. This is the actual work
        behind CoworkOS (Anthropic) and WorkspaceOS (OpenAI) that I created for people to
        use at work (customised and deployed for Finance, Legal, IP, NPD, Test Kitchens
        and GTM teams).
      </p>

      <p>
        I turn messy real-world work into AI products people can understand, trust,
        and use.
      </p>

      <p>
        <strong>Evaluation, evidence and safety</strong>: I test what a system actually
        does, keep provenance where it matters, and put review gates around decisions that
        have real consequences. Same discipline behind <a href="/projects/vai-sante-os/">chain-of-custody
        memory</a> and <a href="/projects/vivid-alpaca/">execution guardrails on live trading</a>.
      </p>

      <p>
        On the product side, I move from problem framing and prototype to a working
        product, with enough technical depth to make good calls along the way.
      </p>
    </div>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <!-- Past lives / archive -->
  <section class="container-wide archive-section" id="archives">
    <div class="archive-header">
      <div>
        <p class="small-caps archive-kicker">Past lives / preserved work</p>
        <h2>Archive</h2>
      </div>
      <span class="small-caps">Three snapshots</span>
    </div>

    <div class="archive-grid">
      {archives.map((archive) => (
        <a
          href={archive.href}
          class={`archive-card archive-card-${archive.variant}`}
          target="_blank"
          rel="noopener"
        >
          <div class="archive-preview" aria-hidden="true">
            <span class="archive-preview-index">{archive.period}</span>
            <span class="archive-preview-title">{archive.title}</span>
            <span class="archive-preview-rule"></span>
            <span class="archive-preview-label">ARCHIVED / OPEN</span>
          </div>
          <div class="archive-card-body">
            <div class="archive-meta small-caps">
              <span>{archive.period}</span>
              <span>{archive.kind}</span>
            </div>
            <h3>{archive.title}</h3>
            <p>{archive.description}</p>
            <span class="archive-cta">Open archive →</span>
          </div>
        </a>
      ))}
    </div>

    <p class="archive-note">
      Earlier work, preserved as standalone sites. The archives open in a new tab so this portfolio remains your wayfinding layer.
    </p>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  /* Hero h1 overrides the global h1: bigger, but still controlled */
  .hero-heading {
    font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.75rem;
  }

  /* Biographical line under the lede. Smaller and quieter so the technical
     sentences above it stay the thing you read first. */
  .lede-bio {
    font-size: 0.95rem;
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-ink-muted);
    max-width: 72ch;
    margin-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .hero-links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    color: var(--color-ink-soft);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Projects list */
  .projects-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .projects-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-divider {
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  .project-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Desktop: number on left, content on right */
  .project-card {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  .project-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-rule);
    line-height: 1;
    font-optical-sizing: auto;
    transition: color 0.2s ease;
    user-select: none;
    padding-top: 0.2rem;
  }

  .project-link:hover .project-num {
    color: color-mix(in srgb, var(--color-accent) 30%, var(--color-rule));
  }

  .project-body {
    padding-top: 0.2rem;
  }

  .project-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .project-link:hover .project-title {
    color: var(--color-accent);
  }

  .project-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 70ch;
    margin-bottom: 1rem;
  }

  .project-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
    align-items: center;
  }

  .more-link {
    margin-top: 4rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  /* ─── Mobile ─── */
  @media (max-width: 600px) {
    .hero-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .hero-br {
      display: none; /* let heading reflow naturally on small screens */
    }

    .hero-links {
      gap: 1rem;
      font-size: 0.8rem;
    }

    .projects-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .projects-header {
      margin-bottom: 2rem;
    }

    /* Stack: number above title on mobile */
    .project-card {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .project-num {
      font-size: 1rem;
      letter-spacing: 0.1em;
      color: var(--color-ink-muted);
      font-weight: 600;
      font-optical-sizing: auto;
      /* Reset to small-caps style on mobile: decorative number becomes tiny label */
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      padding-top: 0;
    }

    .project-divider {
      margin: 2rem 0;
    }
  }

  /* Archive cards: the small preview borrows each site's visual language without
     pulling its large media libraries into the main portfolio. */
  .archive-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .archive-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .archive-kicker {
    margin-bottom: 0.75rem;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .archive-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    background: color-mix(in srgb, var(--color-cream) 74%, white);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .archive-card:hover,
  .archive-card:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-cream);
    transform: translateY(-3px);
  }

  .archive-preview {
    position: relative;
    display: flex;
    min-height: 11rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 1rem;
    border-bottom: 1px solid var(--color-rule);
    background: var(--archive-ink);
    color: var(--archive-paper);
  }

  .archive-preview::before,
  .archive-preview::after {
    position: absolute;
    content: "";
  }

  .archive-preview::before {
    width: 5.5rem;
    height: 5.5rem;
    right: -1.25rem;
    top: -1.25rem;
    background: var(--archive-accent);
  }

  .archive-preview::after {
    width: 3.5rem;
    height: 3.5rem;
    right: 2rem;
    bottom: -1.25rem;
    background: var(--archive-secondary);
  }

  .archive-preview-index,
  .archive-preview-label {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .archive-preview-title {
    position: relative;
    z-index: 1;
    max-width: 9ch;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.8vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .archive-preview-rule {
    position: absolute;
    z-index: 1;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--archive-paper) 35%, transparent);
  }

  .archive-card-designr {
    --archive-ink: #1a1a1a;
    --archive-paper: #f5f3ee;
    --archive-accent: #c23a2c;
    --archive-secondary: #f0c808;
  }

  .archive-card-sans-frontieres {
    --archive-ink: #0057b8;
    --archive-paper: #fafafa;
    --archive-accent: #e63227;
    --archive-secondary: #1a1a1a;
  }

  .archive-card-berlin {
    --archive-ink: #1b1a17;
    --archive-paper: #e4e1d9;
    --archive-accent: #a8371e;
    --archive-secondary: #d6d2c7;
  }

  .archive-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
  }

  .archive-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .archive-meta span:last-child {
    text-align: right;
  }

  .archive-card h3 {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .archive-card:hover h3,
  .archive-card:focus-visible h3 {
    color: var(--color-accent);
  }

  .archive-card p {
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .archive-cta {
    align-self: flex-start;
    margin-top: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    color: var(--color-ink-soft);
    font-size: 0.875rem;
  }

  .archive-card:hover .archive-cta,
  .archive-card:focus-visible .archive-cta {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .archive-note {
    max-width: 65ch;
    margin-top: 2rem;
    color: var(--color-ink-muted);
    font-size: 0.875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-card {
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .archive-card:hover,
    .archive-card:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }

    .archive-card {
      display: grid;
      grid-template-columns: minmax(12rem, 0.8fr) 1fr;
    }

    .archive-preview {
      min-height: 100%;
      border-right: 1px solid var(--color-rule);
      border-bottom: 0;
    }
  }

  @media (max-width: 600px) {
    .archive-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .archive-header {
      margin-bottom: 2rem;
    }

    .archive-card {
      display: flex;
    }

    .archive-preview {
      min-height: 10rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-rule);
    }
  }

  /* Speaking */
  .speaking-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .speaking-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .speaking-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .speaking-divider {
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  .speaking-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .speaking-card {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  .speaking-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .speaking-body {
    padding-top: 0.2rem;
  }

  .speaking-meta {
    margin-bottom: 0.6rem;
    color: var(--color-ink-muted);
  }

  .speaking-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .speaking-link:hover .speaking-title {
    color: var(--color-accent);
  }

  .speaking-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 65ch;
    margin-bottom: 0.75rem;
  }

  .speaking-cta {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .speaking-link:hover .speaking-cta {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .speaking-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .speaking-header {
      margin-bottom: 2rem;
    }

    .speaking-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .speaking-divider {
      margin: 2rem 0;
    }
  }

  /* Writing */
  .writing-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .writing-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .writing-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .writing-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .writing-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

