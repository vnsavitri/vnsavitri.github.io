---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

interface StackTool {
  name: string;
  abbr: string;
  icon?: string;
}

interface StackTier {
  tier: string;
  color: string;
  tools: StackTool[];
}

const techStack: StackTier[] = [
  {
    tier: "Daily Drivers",
    color: "#f07167",
    tools: [
      { name: "Perplexity", abbr: "Px", icon: "https://cdn.simpleicons.org/perplexity" },
      { name: "Claude Code", abbr: "CC", icon: "https://cdn.simpleicons.org/anthropic" },
      { name: "Codex", abbr: "Cx", icon: "https://cdn.simpleicons.org/openai" },
      { name: "Kimi Code", abbr: "KC", icon: "https://cdn.simpleicons.org/kimi" },
    ]
  },
  {
    tier: "Constant Buddies",
    color: "#084b83",
    tools: [
      { name: "Kimi Work", abbr: "KW" },
      { name: "Claude Cowork", abbr: "CW", icon: "https://cdn.simpleicons.org/anthropic" },
      { name: "Hermes Agent", abbr: "HM" },
      { name: "Nemotron 3 Super", abbr: "N3" },
      { name: "OpenRouter", abbr: "OR", icon: "https://cdn.simpleicons.org/openrouter" },
      { name: "ChatGPT", abbr: "CG", icon: "https://cdn.simpleicons.org/openai" },
      { name: "Cursor", abbr: "Cu", icon: "https://cdn.simpleicons.org/cursor" },
    ]
  },
  {
    tier: "Specialists",
    color: "#2d6a9f",
    tools: [
      { name: "LM Studio", abbr: "LM" },
      { name: "Ollama", abbr: "Ol", icon: "https://cdn.simpleicons.org/ollama" },
      { name: "HuggingFace", abbr: "HF", icon: "https://cdn.simpleicons.org/huggingface" },
      { name: "LangChain", abbr: "LC", icon: "https://cdn.simpleicons.org/langchain" },
      { name: "Qwen Studio", abbr: "QW" },
      { name: "Vercel", abbr: "Vc", icon: "https://cdn.simpleicons.org/vercel" },
      { name: "NotebookLM", abbr: "NL" },
    ]
  },
  {
    tier: "Experimenting",
    color: "#42bfdd",
    tools: [
      { name: "Claude Design", abbr: "CD", icon: "https://cdn.simpleicons.org/anthropic" },
      { name: "Gemini", abbr: "Gm", icon: "https://cdn.simpleicons.org/googlegemini" },
      { name: "DeepSeek", abbr: "DS", icon: "https://cdn.simpleicons.org/deepseek" },
      { name: "Google Veo", abbr: "Veo" },
      { name: "Open Notebook", abbr: "ON" },
      { name: "ElevenLabs", abbr: "EL", icon: "https://cdn.simpleicons.org/elevenlabs" },
    ]
  }
];
---

<Layout title="Vivid Savitri-Hampton | Applied AI engineer">
  <!-- Hero -->
  <section class="container-wide hero-section">
    <p class="small-caps" style="margin-bottom: 1.75rem;">AI / Product / Sydney</p>

    <h1 class="hero-heading">
      I build AI systems that take<br class="hero-br" />
      <span style="color: var(--color-accent);">safety</span> as seriously as
      <span style="color: var(--color-accent);">capability.</span>
    </h1>

    <p class="lede">
      I work across product, research, and engineering: multi-agent systems, goal-driven agent loops, local AI operating systems, memory that knows where it came from. Some of that work ships inside a global hardware company, and some of it started as a problem I had myself and could not find a decent tool for.
    </p>

    <p class="lede-bio">
      Before any of that there were two startup exits in video games, one out of Shanghai and another while in Berlin, and a long stretch of living and working across twelve countries on four continents that eventually landed me in Sydney.
    </p>

    <nav class="hero-links">
      <a href="/about">About →</a>
      <a href="https://www.vnsavitri.com/" target="_blank" rel="noopener">vnsavitri.com →</a>
      <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
      <a href="https://www.linkedin.com/in/vnsavitri/" target="_blank" rel="noopener">LinkedIn →</a>
    </nav>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <!-- Projects -->
  <section class="container-wide projects-section">
    <div class="projects-header">
      <h2>Featured work</h2>
      <span class="small-caps">Six projects</span>
    </div>

    <ol class="projects-list">
      {projects.map((project, idx) => (
        <li class="project-item">
          {idx > 0 && <div class="project-divider"></div>}
          <a href={`/projects/${project.data.slug}/`} class="project-link">
            <article class="project-card">
              <div class="project-num" aria-hidden="true">0{idx + 1}</div>

              <div class="project-body">
                <h3 class="project-title">{project.data.title}</h3>

                <p class="project-hook">{project.data.hook}</p>

                <div class="project-pills">
                  {project.data.status.map((s: string, i: number) => (
                    <span class={`pill ${i === 0 && project.data.accent ? "pill-accent" : ""}`}>{s}</span>
                  ))}
                  {project.data.stars && (
                    <span class="pill">★ {project.data.stars}</span>
                  )}
                </div>

                <div class="tech-tag">{project.data.tech.join(" · ")}</div>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ol>

    <p class="more-link">
      More on <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
    </p>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide stack-section">
    <div class="stack-header">
      <h2>Current tech stack</h2>
      <span class="small-caps">AI tools</span>
    </div>

    <div class="stack-table">
      {techStack.map((row) => (
        <div class="stack-row" style={`--tier-color: ${row.color}`}>
          <div class="stack-label">
            {row.tier}
          </div>
          <div class="stack-tools">
            {row.tools.map((tool) => (
              <div class="stack-chip">
                {tool.icon && (
                  <img
                    src={tool.icon}
                    alt=""
                    class="stack-chip-icon"
                    width="16"
                    height="16"
                    loading="lazy"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"
                  />
                )}
                <span
                  class="stack-chip-abbr"
                  style={tool.icon ? "display:none" : "display:inline-flex"}
                >
                  {tool.abbr}
                </span>
                <span class="stack-chip-name">{tool.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="stack-legend">
      <span><span class="legend-dot" style="background:#f07167"></span>daily drivers: every day</span>
      <span><span class="legend-dot" style="background:#084b83"></span>constant buddies: weekly regulars</span>
      <span><span class="legend-dot" style="background:#2d6a9f"></span>specialists: task-specific</span>
      <span><span class="legend-dot" style="background:#42bfdd"></span>experimenting: rarely, still forming an opinion</span>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  /* Hero h1 overrides the global h1: bigger, but still controlled */
  .hero-heading {
    font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.75rem;
  }

  /* Biographical line under the lede. Smaller and quieter so the technical
     sentences above it stay the thing you read first. */
  .lede-bio {
    font-size: 0.95rem;
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-ink-muted);
    max-width: 72ch;
    margin-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .hero-links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    color: var(--color-ink-soft);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Projects list */
  .projects-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .projects-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-divider {
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  .project-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Desktop: number on left, content on right */
  .project-card {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  .project-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-rule);
    line-height: 1;
    font-optical-sizing: auto;
    transition: color 0.2s ease;
    user-select: none;
    padding-top: 0.2rem;
  }

  .project-link:hover .project-num {
    color: color-mix(in srgb, var(--color-accent) 30%, var(--color-rule));
  }

  .project-body {
    padding-top: 0.2rem;
  }

  .project-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .project-link:hover .project-title {
    color: var(--color-accent);
  }

  .project-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 70ch;
    margin-bottom: 1rem;
  }

  .project-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
    align-items: center;
  }

  .more-link {
    margin-top: 4rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  /* ─── Mobile ─── */
  @media (max-width: 600px) {
    .hero-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .hero-br {
      display: none; /* let heading reflow naturally on small screens */
    }

    .hero-links {
      gap: 1rem;
      font-size: 0.8rem;
    }

    .projects-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .projects-header {
      margin-bottom: 2rem;
    }

    /* Stack: number above title on mobile */
    .project-card {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .project-num {
      font-size: 1rem;
      letter-spacing: 0.1em;
      color: var(--color-ink-muted);
      font-weight: 600;
      font-optical-sizing: auto;
      /* Reset to small-caps style on mobile: decorative number becomes tiny label */
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      padding-top: 0;
    }

    .project-divider {
      margin: 2rem 0;
    }
  }

  /* Tech Stack */
  .stack-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .stack-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .stack-row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0 2rem;
    align-items: start;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-rule);
  }

  .stack-row:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .stack-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    font-weight: 600;
    padding-top: 0.3rem;
  }

  .stack-label::before {
    content: "";
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tier-color);
  }

  .stack-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .stack-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-ink-soft);
    padding: 0.25rem 0.6rem 0.25rem 0.45rem;
    border: 1px solid var(--color-rule);
    border-radius: 9999px;
    background: transparent;
    white-space: nowrap;
    transition: border-color 0.15s ease, color 0.15s ease;
    cursor: default;
  }

  .stack-chip:hover {
    border-color: color-mix(in srgb, var(--tier-color) 50%, var(--color-rule));
    color: var(--color-ink);
  }

  .stack-chip-icon {
    width: 14px;
    height: 14px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .stack-chip-abbr {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0;
    border-radius: 2px;
    background: color-mix(in srgb, var(--tier-color) 12%, transparent);
    color: var(--tier-color);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .stack-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .stack-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1rem 0;
    }

    .stack-label {
      padding-top: 0;
    }

    .stack-header {
      margin-bottom: 1.5rem;
    }
  }

  .stack-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
  }

  .stack-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
