---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

---

<Layout title="Vivid Savitri-Hampton | Applied AI engineer">
  <!-- Hero -->
  <section class="container-wide hero-section">
    <p class="small-caps" style="margin-bottom: 1.75rem;">AI / Product / Sydney</p>

    <h1 class="hero-heading">
      I build AI systems that take<br class="hero-br" />
      <span style="color: var(--color-accent);">safety</span> as seriously as
      <span style="color: var(--color-accent);">capability.</span>
    </h1>

    <p class="lede">
      I work across product, research, and engineering: multi-agent systems, goal-driven agent loops, local AI operating systems, memory that knows where it came from. Some of that work ships inside a global hardware company, and some of it started as a problem I had myself and could not find a decent tool for.
    </p>

    <p class="lede-bio">
      Before any of that there were two startup exits in video games, one out of Shanghai and another while in Berlin, and a long stretch of living and working across twelve countries on four continents that eventually landed me in Sydney.
    </p>

    <nav class="hero-links">
      <a href="/about">About →</a>
      <a href="https://www.vnsavitri.com/" target="_blank" rel="noopener">vnsavitri.com →</a>
      <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
      <a href="https://www.linkedin.com/in/vnsavitri/" target="_blank" rel="noopener">LinkedIn →</a>
    </nav>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <!-- Projects -->
  <section class="container-wide projects-section">
    <div class="projects-header">
      <h2>Featured work</h2>
      <span class="small-caps">Six projects</span>
    </div>

    <ol class="projects-list">
      {projects.map((project, idx) => (
        <li class="project-item">
          {idx > 0 && <div class="project-divider"></div>}
          <a href={`/projects/${project.data.slug}/`} class="project-link">
            <article class="project-card">
              <div class="project-num" aria-hidden="true">0{idx + 1}</div>

              <div class="project-body">
                <h3 class="project-title">{project.data.title}</h3>

                <p class="project-hook">{project.data.hook}</p>

                <div class="project-pills">
                  {project.data.status.map((s: string, i: number) => (
                    <span class={`pill ${i === 0 && project.data.accent ? "pill-accent" : ""}`}>{s}</span>
                  ))}
                  {project.data.stars && (
                    <span class="pill">★ {project.data.stars}</span>
                  )}
                </div>

                <div class="tech-tag">{project.data.tech.join(" · ")}</div>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ol>

    <p class="more-link">
      More on <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
    </p>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide speaking-section">
    <div class="speaking-header">
      <h2>Speaking</h2>
      <span class="small-caps">Two engagements</span>
    </div>

    <ol class="speaking-list">
      <li class="speaking-item">
        <a href="https://vercel.com/blog/vercel-ship-2026-recap" target="_blank" rel="noopener" class="speaking-link">
          <article class="speaking-card">
            <img
              src="/vercel-ship-syd-2026.webp"
              alt="Panel on stage at Vercel Ship Sydney 2026: The AI org, people, structure, and the decisions that matter"
              class="speaking-thumb"
              width="1200"
              height="673"
              loading="lazy"
              decoding="async"
            />
            <div class="speaking-body">
              <div class="speaking-meta small-caps">Vercel Ship Sydney · 2026</div>
              <h3 class="speaking-title">The AI org: people, structure, and the decisions that matter</h3>
              <p class="speaking-hook">
                Panel with Tom Glover (MYOB) and Kristina Ryan (Go1), moderated by JJ Lecocq (Vercel).
                The interesting part was the cross-industry contrast: legacy cleanup, shadow-AI sprawl,
                and a modern stack running inside a 94-year-old hardware company, all wrestling with the
                same tension between moving fast and building foundations that hold.
              </p>
              <span class="speaking-cta">Read the recap →</span>
            </div>
          </article>
        </a>
      </li>
      <li class="speaking-item">
        <div class="speaking-divider"></div>
        <a href="https://www.clutchevents.co/events/sydney-enterprise-ai-and-automation-summit-2026" target="_blank" rel="noopener" class="speaking-link">
          <article class="speaking-card">
            <img
              src="/clutch-enterprise-ai-summit-2026.webp"
              alt="Speaker card for Vivid Savitri at the Sydney Enterprise AI and Automation Summit 2026"
              class="speaking-thumb"
              width="1200"
              height="667"
              loading="lazy"
              decoding="async"
            />
            <div class="speaking-body">
              <div class="speaking-meta small-caps">Sydney Enterprise AI and Automation Summit · 2026</div>
              <h3 class="speaking-title">Is your AI program hitting the mark?</h3>
              <p class="speaking-hook">
                Panel discussion on enterprise AI program evaluation, hosted by Clutch Events in Sydney.
              </p>
              <span class="speaking-cta">Event details →</span>
            </div>
          </article>
        </a>
      </li>
    </ol>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide build-section">
    <div class="build-header">
      <h2>How I build</h2>
      <span class="small-caps">Five principles</span>
    </div>

    <div class="prose-body">
      <p>
        I use AI where it earns its place. Half the fun is figuring out whether it's
        actually helping or just slowing me down, especially the moment it starts
        producing slop. Ain't nobody got time to babysit a dumb agent.
      </p>

      <ul>
        <li>
          <strong>Open-source and local AI</strong>: I default to open and local models
          first, weighing privacy, cost, capability and the job in front of me. Day to
          day that's LM Studio and Ollama running open weights, Qwen included. At work
          the stack is closed, mostly OpenAI and Anthropic, which comes with its own
          tradeoffs.
        </li>
        <li>
          <strong>Agent loops and graph engineering</strong>: I build the harness around
          agent workflows, explicit state, scoped delegation, handoffs that actually
          carry context, and memory that doesn't turn into a junk drawer. This is the
          actual work behind CoworkOS and WorkspaceOS.
        </li>
        <li>
          <strong>Human-AI product design</strong>: I turn messy real-world work into AI
          products people can understand, trust, and use.
        </li>
        <li>
          <strong>Evaluation, evidence and safety</strong>: I test what a system actually
          does, keep provenance where it matters, and put review gates around decisions
          that have real consequences. Same discipline behind <a href="/projects/vai-sante-os/">chain-of-custody
          memory</a> and <a href="/projects/vivid-alpaca/">execution guardrails on live trading</a>.
        </li>
        <li>
          <strong>Product direction and delivery</strong>: I move from problem framing
          and prototype to a working product, with enough technical depth to make good
          calls along the way.
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  /* Hero h1 overrides the global h1: bigger, but still controlled */
  .hero-heading {
    font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: 1.75rem;
  }

  /* Biographical line under the lede. Smaller and quieter so the technical
     sentences above it stay the thing you read first. */
  .lede-bio {
    font-size: 0.95rem;
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-ink-muted);
    max-width: 72ch;
    margin-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .hero-links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    color: var(--color-ink-soft);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero-links a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Projects list */
  .projects-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .projects-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-divider {
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  .project-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Desktop: number on left, content on right */
  .project-card {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  .project-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-rule);
    line-height: 1;
    font-optical-sizing: auto;
    transition: color 0.2s ease;
    user-select: none;
    padding-top: 0.2rem;
  }

  .project-link:hover .project-num {
    color: color-mix(in srgb, var(--color-accent) 30%, var(--color-rule));
  }

  .project-body {
    padding-top: 0.2rem;
  }

  .project-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .project-link:hover .project-title {
    color: var(--color-accent);
  }

  .project-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 70ch;
    margin-bottom: 1rem;
  }

  .project-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
    align-items: center;
  }

  .more-link {
    margin-top: 4rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  /* ─── Mobile ─── */
  @media (max-width: 600px) {
    .hero-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .hero-br {
      display: none; /* let heading reflow naturally on small screens */
    }

    .hero-links {
      gap: 1rem;
      font-size: 0.8rem;
    }

    .projects-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .projects-header {
      margin-bottom: 2rem;
    }

    /* Stack: number above title on mobile */
    .project-card {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .project-num {
      font-size: 1rem;
      letter-spacing: 0.1em;
      color: var(--color-ink-muted);
      font-weight: 600;
      font-optical-sizing: auto;
      /* Reset to small-caps style on mobile: decorative number becomes tiny label */
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      padding-top: 0;
    }

    .project-divider {
      margin: 2rem 0;
    }
  }

  /* Speaking */
  .speaking-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .speaking-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3.5rem;
  }

  .speaking-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .speaking-divider {
    border-top: 1px solid var(--color-rule);
    margin: 2.5rem 0;
  }

  .speaking-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .speaking-card {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }

  .speaking-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .speaking-body {
    padding-top: 0.2rem;
  }

  .speaking-meta {
    margin-bottom: 0.6rem;
    color: var(--color-ink-muted);
  }

  .speaking-title {
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .speaking-link:hover .speaking-title {
    color: var(--color-accent);
  }

  .speaking-hook {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 65ch;
    margin-bottom: 0.75rem;
  }

  .speaking-cta {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .speaking-link:hover .speaking-cta {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .speaking-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .speaking-header {
      margin-bottom: 2rem;
    }

    .speaking-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .speaking-divider {
      margin: 2rem 0;
    }
  }

  /* How I build */
  .build-section {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .build-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 640px) {
    .build-section {
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .build-header {
      margin-bottom: 1.5rem;
    }
  }
</style>
