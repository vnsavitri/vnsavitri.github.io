---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="Vivid Savitri — AI product builder"
  description="AI product builder and researcher. Building agentic systems, MCP servers, and tools for high-stakes AI workflows."
>
  <!-- Hero -->
  <section class="container-wide pt-16 pb-28">
    <p class="small-caps mb-8">AI / Product / Sydney</p>

    <h1 class="mb-7">
      I build AI systems that take<br />
      <span style="color: var(--color-accent);">safety</span> as seriously as
      <span style="color: var(--color-accent);">capability.</span>
    </h1>

    <p class="lede mb-10">
      Product, research, and engineering across multi-agent systems, MCP servers, and
      provenance-aware memory for high-stakes AI workflows. Two startup exits, twelve countries,
      and a long-running suspicion that the best products are the ones you can't ship without
      thinking about who they fail on.
    </p>

    <div class="flex gap-8" style="font-size: 0.875rem;">
      <a href="/about" style="text-decoration: none; border-bottom: 1px solid var(--color-rule); padding-bottom: 2px;">
        About →
      </a>
      <a href="https://github.com/vnsavitri" target="_blank" rel="noopener" style="text-decoration: none; border-bottom: 1px solid var(--color-rule); padding-bottom: 2px;">
        GitHub →
      </a>
      <a href="https://www.linkedin.com/in/vividsavitri/" target="_blank" rel="noopener" style="text-decoration: none; border-bottom: 1px solid var(--color-rule); padding-bottom: 2px;">
        LinkedIn →
      </a>
    </div>
  </section>

  <!-- Divider -->
  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <!-- Projects -->
  <section class="container-wide pt-16 pb-28">
    <div class="flex items-baseline justify-between mb-14">
      <h2>Featured Work</h2>
      <span class="small-caps">Six projects</span>
    </div>

    <ol class="list-none p-0 m-0">
      {projects.map((project, idx) => (
        <li>
          {idx > 0 && <div style="border-top: 1px solid var(--color-rule); margin: 2.75rem 0;"></div>}
          <a
            href={`/projects/${project.data.slug}/`}
            style="text-decoration: none; display: block;"
            class="group"
          >
            <article style="display: grid; grid-template-columns: 5rem 1fr; gap: 0 2rem; align-items: start;">
              <!-- Large decorative number -->
              <div class="project-num" aria-hidden="true">
                0{idx + 1}
              </div>

              <div style="padding-top: 0.25rem;">
                <h3
                  class="group-hover:text-[var(--color-accent)]"
                  style="transition: color 0.15s ease; margin-bottom: 0.6rem;"
                >
                  {project.data.title}
                </h3>

                <p style="font-size: 1rem; line-height: 1.6; color: var(--color-ink-soft); max-width: 56ch; margin-bottom: 1rem;">
                  {project.data.hook}
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; align-items: center;">
                  {project.data.status.map((s: string, i: number) => (
                    <span class={`pill ${i === 0 && project.data.accent ? "pill-accent" : ""}`}>{s}</span>
                  ))}
                  {project.data.stars && (
                    <span class="pill">★ {project.data.stars}</span>
                  )}
                </div>

                <div class="tech-tag">
                  {project.data.tech.join(" · ")}
                </div>
              </div>
            </article>
          </a>
        </li>
      ))}
    </ol>

    <p style="margin-top: 4rem; font-size: 0.875rem; color: var(--color-ink-muted);">
      More on <a href="https://github.com/vnsavitri" target="_blank" rel="noopener">GitHub →</a>
    </p>
  </section>
</Layout>

<style>
  .group:hover .project-num {
    color: color-mix(in srgb, var(--color-accent) 30%, var(--color-rule)) !important;
  }
</style>
