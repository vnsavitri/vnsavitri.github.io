---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import LibraryCard from "../components/LibraryCard.astro";
import Bookshelf from "../components/Bookshelf.astro";

const decks = (await getCollection("library")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recentDecks = decks.slice(0, 8);

const CATEGORY_LABELS: Record<string, string> = {
  slides: "Slide Decks",
  guides: "Claude & AI Guides",
  architecture: "Architecture & Tech",
  books: "Book Notes",
};
---

<Layout
  title="Library | Vivid Savitri-Hampton"
  description="Slide decks, guides and research notes built with AI, shared for anyone who finds them useful."
  pathname="/library"
>
  <section class="container-wide library-header">
    <p class="small-caps">Library</p>
    <h1>Slides, guides and field notes</h1>
    <p class="lede">
      {decks.length} AI-built decks and guides on agent systems, model research and how I
      work. Built as I go, shared in case they save you time.
    </p>
  </section>

  <section class="container-wide library-recent" id="lib-recent">
    <p class="small-caps lib-recent-heading">Recently added</p>
    <div class="lib-grid">
      {recentDecks.map((deck) => (
        <LibraryCard
          slug={deck.data.slug}
          title={deck.data.title}
          file={deck.data.file}
          thumb={deck.data.thumb}
          categoryLabel={CATEGORY_LABELS[deck.data.category]}
          badge
        />
      ))}
    </div>
  </section>

  <div class="container-wide" style="border-top: 1px solid var(--color-rule);"></div>

  <section class="container-wide library-controls">
    <input
      type="text"
      id="lib-search"
      class="lib-search"
      placeholder="Search the library…"
      autocomplete="off"
    />
    <div class="lib-filters" id="lib-filters">
      <button class="lib-filter-btn active" data-cat="all">All</button>
      {Object.entries(CATEGORY_LABELS).map(([cat, label]) => (
        <button class="lib-filter-btn" data-cat={cat}>{label}</button>
      ))}
    </div>
  </section>

  <section class="container-wide">
    <p class="small-caps lib-summary" id="lib-summary">Showing all {decks.length}</p>
    <p class="lib-no-results" id="lib-no-results">Nothing matches that search.</p>
  </section>

  <Bookshelf decks={decks} categoryLabels={CATEGORY_LABELS} />
</Layout>

<style>
  .library-header {
    padding-top: 3rem;
  }

  .library-header .lede {
    margin-top: 1rem;
  }

  .library-recent {
    padding-top: 2.5rem;
  }

  .lib-recent-heading {
    margin-bottom: 1.25rem;
  }

  .library-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 2.5rem;
  }

  .lib-search {
    flex: 1;
    min-width: 220px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-ink);
    background: var(--color-cream-deep);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 0.6rem 1rem;
    outline: none;
  }

  .lib-search:focus {
    border-color: var(--color-ink-soft);
  }

  .lib-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lib-filter-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: 9999px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .lib-filter-btn:hover,
  .lib-filter-btn.active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-cream);
  }

  .lib-summary {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .lib-no-results {
    display: none;
    color: var(--color-ink-muted);
    padding: 2rem 0;
  }

  .lib-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.75rem;
    padding-bottom: 5rem;
  }
</style>
