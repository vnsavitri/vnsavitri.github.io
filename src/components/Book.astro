---
interface Props {
  slug: string;
  title: string;
  file: string;
  thumb: string;
  category: string;
  categoryLabel: string;
  slideCount?: number;
  sizeKb?: number;
}

const { slug, title, file, thumb, category, categoryLabel, slideCount = 0, sizeKb = 20 } =
  Astro.props;

// A file with slides is a real deck and gets a hardcover whose thickness
// tracks slide count. Zero slides means a long-scrolling guide: a thinner
// paperback sized from file weight instead.
const isHardcover = slideCount > 0;

const clamp = (min: number, value: number, max: number) =>
  Math.round(Math.min(max, Math.max(min, value)));

// Roughly 6:1 height-to-thickness at the median, which is what a real
// hardcover measures. Thinner than that and the shelf reads as a barcode.
const thickness = isHardcover
  ? clamp(28, 20 + slideCount * 0.85, 56)
  : clamp(17, 13 + sizeKb * 0.14, 24);

// Uneven top line, but derived from the data rather than random, so it stays
// identical between builds.
const height = isHardcover ? 224 + (slideCount % 5) * 6 : 206 + (sizeKb % 4) * 4;

// Cloth is drawn only from existing site tokens. Coral is deliberately absent
// as a field colour: at spine text sizes it fails contrast against both cream
// and ink, so it appears only as the hairline band below.
const CLOTHS = [
  { bg: "var(--color-ink)", fg: "var(--color-cream)" },
  { bg: "color-mix(in srgb, var(--color-ink) 88%, var(--color-accent))", fg: "var(--color-cream)" },
  { bg: "var(--color-ink-soft)", fg: "var(--color-cream)" },
  { bg: "var(--color-cream-deep)", fg: "var(--color-ink)" },
  { bg: "var(--color-code-bg)", fg: "var(--color-ink)" },
  { bg: "var(--color-rule)", fg: "var(--color-ink)" },
];

// Category sets where in the palette a section starts, so each section leans a
// different way while still mixing dark and light spines like a real shelf.
const CATEGORY_OFFSET: Record<string, number> = {
  slides: 0,
  guides: 2,
  architecture: 4,
  books: 3,
};
const cloth =
  CLOTHS[((CATEGORY_OFFSET[category] ?? 0) + (isHardcover ? slideCount : sizeKb)) % CLOTHS.length];

const typeLabel = isHardcover ? "Slide deck" : "Guide";
const ariaLabel = isHardcover
  ? `${title}. ${typeLabel}, ${slideCount} slides.`
  : `${title}. ${typeLabel}.`;

const vars = [
  `--t:${thickness}px`,
  `--h:${height}px`,
  `--cloth:${cloth.bg}`,
  `--cloth-ink:${cloth.fg}`,
].join(";");
---

<li
  class:list={["book-slot", isHardcover ? "is-hardcover" : "is-paperback"]}
  style={vars}
  data-category={category}
  data-title={title.toLowerCase()}
>
  <a class="book" href={file} target="_blank" rel="noopener" data-slug={slug} aria-label={ariaLabel}>
    <span class="book__spine" aria-hidden="true">
      <span class="book__band book__band--head"></span>
      <span class="book__spine-title">{title}</span>
      <span class="book__band book__band--tail"></span>
    </span>

    <span class="book__cover" aria-hidden="true">
      <span class="book__cover-kicker">{categoryLabel}</span>
      <span class="book__cover-title">{title}</span>
      <span class="book__cover-art">
        <img src={thumb} alt="" loading="lazy" decoding="async" width="640" height="400" />
      </span>
    </span>

    <span class="book__top" aria-hidden="true"></span>
  </a>

  <div class="book-chip">
    <span class="book-chip__art">
      <img src={thumb} alt="" loading="lazy" decoding="async" width="640" height="400" />
    </span>
    <span class="book-chip__title">{title}</span>
    <span class="book-chip__meta">
      <span class="lib-views" data-slug={slug}></span>
      <button
        type="button"
        class="lib-like"
        data-slug={slug}
        aria-pressed="false"
        aria-label={`Like ${title}`}
      >
        <span class="lib-like-icon">♡</span>
        <span class="lib-like-count">0</span>
      </button>
    </span>
  </div>
</li>

<style>
  .book-slot {
    /* Each book gets its own perspective. One shared perspective across a
       3,000px+ shelf fisheyes the far ends; per-slot keeps every book
       identical, which is also how a real shelf looks on a long lens. */
    perspective: 1400px;
    perspective-origin: 50% 45%;
    position: relative;
    flex: 0 0 auto;
    width: var(--t);
    height: var(--h);
    scroll-margin-inline: 2rem;
  }

  .book-slot.hidden {
    display: none;
  }

  .book-slot:hover,
  .book-slot:focus-within {
    z-index: 10;
  }

  .book {
    position: relative;
    display: block;
    width: var(--t);
    height: var(--h);
    transform-style: preserve-3d;
    transform-origin: left center;
    transition: transform 0.28s ease;
    text-decoration: none;
  }

  .book:hover,
  .book:focus-visible {
    transform: translateZ(28px) rotateY(-58deg);
  }

  .book:focus-visible {
    outline: none;
  }

  .book-slot:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* Contact shadow. Kept on a pseudo-element with a fixed value so only
     opacity animates, not the shadow: transitioning box-shadow itself repaints every frame. */
  .book::after {
    content: "";
    position: absolute;
    inset: auto -2px -1px -2px;
    height: 10px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-ink) 38%, transparent) 0%,
      transparent 85%
    );
    opacity: 0.7;
    transition: opacity 0.28s ease;
  }

  .book:hover::after,
  .book:focus-visible::after {
    opacity: 0.3;
  }

  .book__spine,
  .book__cover,
  .book__top {
    position: absolute;
    top: 0;
    left: 0;
  }

  .book__spine {
    width: var(--t);
    height: var(--h);
    /* Lifts the spine off the shared plane so it never z-fights the cover's
       hinge edge on mobile Safari. */
    transform: translateZ(0.01px);
    background: var(--cloth);
    background-image: linear-gradient(
      100deg,
      color-mix(in srgb, var(--color-cream) 22%, transparent) 0%,
      transparent 38%,
      color-mix(in srgb, var(--color-ink) 22%, transparent) 100%
    );
    border-radius: 1px 2px 2px 1px;
    /* Lit left edge, shadowed right edge. Without these the pale cloths
       dissolve into the cream page and into each other. */
    box-shadow:
      inset 1px 0 0 color-mix(in srgb, var(--color-cream) 30%, transparent),
      inset -1px 0 0 color-mix(in srgb, var(--color-ink) 26%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
    overflow: hidden;
  }

  .book__spine-title {
    flex: 1;
    min-height: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--cloth-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-block: 8px;
  }

  /* Raised bands, the detail that separates a bound hardcover from a
     perfect-bound paperback. */
  .book__band {
    width: 100%;
    height: 3px;
    flex: 0 0 auto;
    background: color-mix(in srgb, var(--cloth-ink) 32%, transparent);
    border-block: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .is-paperback .book__band {
    display: none;
  }

  .is-hardcover .book__band--head {
    box-shadow: 0 5px 0 -2px var(--color-accent);
  }

  .book__cover {
    width: var(--w, 168px);
    height: var(--h);
    left: var(--t);
    transform-origin: left center;
    transform: rotateY(90deg);
    background: var(--cloth);
    background-image: linear-gradient(
      120deg,
      color-mix(in srgb, var(--color-cream) 16%, transparent),
      transparent 55%
    );
    border-radius: 0 3px 3px 0;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-left: none;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .book__cover-kicker {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cloth-ink) 70%, transparent);
  }

  .book__cover-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--cloth-ink);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* The thumbnail is 8:5 landscape and the cover is portrait. Rather than
     crop it to fit, it sits as a letterboxed inset band at its true ratio. */
  .book__cover-art {
    margin-top: auto;
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--cloth-ink) 22%, transparent);
  }

  .book__cover-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book__top {
    width: var(--t);
    height: var(--w, 168px);
    transform-origin: center top;
    transform: rotateX(-90deg);
    background: var(--color-cream);
    background-image: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-ink) 12%, transparent) 0 1px,
      transparent 1px 3px
    );
    border-radius: 1px;
  }

  /* Metadata lives in a flat 2D chip, never on the rotated cover: text in a
     -58deg plane renders blurry and a rotated button has a skewed hit target. */
  .book-chip {
    position: absolute;
    top: calc(var(--h) + 18px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 210px;
    padding: 0.5rem 0.7rem;
    background: var(--color-cream);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-ink) 14%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .book-slot:hover .book-chip,
  .book-slot:focus-within .book-chip,
  .book-slot.is-previewing .book-chip {
    opacity: 1;
    pointer-events: auto;
  }

  /* Only ever shown on touch, where the 3D cover is hidden and the chip is
     the entire preview. display:none elsewhere, so it is never fetched. */
  .book-chip__art {
    display: none;
  }

  /* Two lines maximum. The chip lives in the scroller's bottom padding, so an
     unclamped long title grows the chip until the scroller clips it. The full
     title is on the cover and in the link's accessible name regardless. */
  .book-chip__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .book-chip__meta {
    margin-top: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .book-chip .lib-views {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-ink-muted);
  }

  .book-chip .lib-like {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.1rem 0.2rem;
  }

  .book-chip .lib-like[aria-pressed="true"] {
    color: var(--color-accent);
  }

  /* Deliberately unlike the transform:none pattern used elsewhere on the site:
     killing the transform here would mean the cover could never be revealed at
     all. The state change still happens, it just happens instantly. */
  @media (prefers-reduced-motion: reduce) {
    .book,
    .book::after,
    .book-chip {
      transition: none;
    }
  }

  /* Below the mobile breakpoint the 3D is dropped entirely rather than
     shrunk: 75 perspective contexts is a real risk on mobile Safari, and the
     effect barely reads at this width anyway. */
  @media (max-width: 600px) {
    .book-slot {
      perspective: none;
      width: max(var(--t), 34px);
      height: calc(var(--h) * 0.8);
    }

    .book {
      width: max(var(--t), 34px);
      height: calc(var(--h) * 0.8);
      transform-style: flat;
      min-height: 44px;
    }

    /* The preview becomes a bottom sheet rather than a chip parked under the
       book: it cannot be clipped by the scroller, it needs no reserved space
       in the run, and it is the pattern a thumb expects. */
    .book-chip {
      position: fixed;
      top: auto;
      bottom: 1rem;
      left: 1rem;
      right: 1rem;
      width: auto;
      max-width: none;
      transform: none;
      z-index: 50;
      padding: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .book-chip__art {
      display: block;
      flex: 0 0 96px;
      aspect-ratio: 8 / 5;
      overflow: hidden;
      border-radius: 4px;
      border: 1px solid var(--color-rule);
    }

    .book-chip__art img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .book-chip__title {
      flex: 1;
      min-width: 0;
      font-size: 0.85rem;
    }

    .book-chip__meta {
      flex: 0 0 100%;
      margin-top: 0;
    }

    .book:hover,
    .book:focus-visible {
      transform: none;
    }

    .book__cover,
    .book__top {
      display: none;
    }

    .book__spine {
      width: 100%;
      height: 100%;
    }
  }
</style>
