---
import Book from "./Book.astro";

interface Deck {
  data: {
    slug: string;
    title: string;
    file: string;
    thumb: string;
    category: string;
    slideCount?: number;
    sizeKb?: number;
  };
}

interface Props {
  decks: Deck[];
  categoryLabels: Record<string, string>;
}

const { decks, categoryLabels } = Astro.props;

const sections = Object.entries(categoryLabels)
  .map(([category, label]) => ({
    category,
    label,
    books: decks.filter((d) => d.data.category === category),
  }))
  .filter((s) => s.books.length > 0);
---

<div class="shelf">
  <div class="shelf-scroller" id="lib-shelf" tabindex="-1">
    <div class="shelf-run">
      {sections.map((section) => (
        <section class="shelf-section" id={`shelf-${section.category}`} data-section={section.category}>
          <span class="shelf-section__label" aria-hidden="true">{section.label}</span>
          <span class="shelf-divider" aria-hidden="true"></span>
          <h3 class="shelf-sr-only">{section.label}</h3>
          <ul class="shelf-books">
            {section.books.map((deck) => (
              <Book
                slug={deck.data.slug}
                title={deck.data.title}
                file={deck.data.file}
                thumb={deck.data.thumb}
                category={deck.data.category}
                categoryLabel={section.label}
                slideCount={deck.data.slideCount}
                sizeKb={deck.data.sizeKb}
              />
            ))}
          </ul>
        </section>
      ))}
      <span class="shelf-divider shelf-divider--end" aria-hidden="true"></span>
    </div>
  </div>
  <div class="shelf-fade shelf-fade--start" aria-hidden="true"></div>
  <div class="shelf-fade shelf-fade--end" aria-hidden="true"></div>
</div>

<style>
  .shelf {
    position: relative;
    margin-top: 1.5rem;
  }

  .shelf-scroller {
    /* auto + hidden, never auto + visible: the browser silently computes
       `visible` as `auto` on the other axis, which adds a phantom vertical
       scrollbar and guillotines every pulled-out book. */
    overflow: auto hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline-start: 2rem;
    scroll-behavior: smooth;
    /* Deliberately visible. There is no wheel-hijacking here, so the
       scrollbar is the only affordance telling a mouse user the shelf runs on. */
    scrollbar-width: thin;
    scrollbar-color: var(--color-ink-muted) transparent;
  }

  .shelf-scroller::-webkit-scrollbar {
    height: 10px;
  }

  .shelf-scroller::-webkit-scrollbar-track {
    background: transparent;
  }

  .shelf-scroller::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-ink) 35%, transparent);
    border-radius: 999px;
    border: 3px solid var(--color-cream);
  }

  .shelf-scroller::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .shelf-scroller:focus {
    outline: none;
  }

  .shelf-run {
    --plank-h: 18px;
    --chip-space: 6.25rem;
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 0;
    width: max-content;
    /* Top room for the pull-out, bottom room for the metadata chip. Without
       these the scroller's own clipping cuts both off. */
    padding: 4.5rem clamp(1.25rem, 8vw, 8rem) var(--chip-space);
  }

  /* The plank. Sits exactly at the books' baseline and runs the full
     scrollable width. */
  .shelf-run::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--chip-space) - var(--plank-h));
    height: var(--plank-h);
    /* Front face of the plank: a lit top lip, a solid body, a shadowed
       underside. This is the element that makes the books look supported
       rather than floating. */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-ink) 26%, var(--color-cream)) 0 2px,
      color-mix(in srgb, var(--color-ink) 40%, var(--color-cream)) 2px 62%,
      color-mix(in srgb, var(--color-ink) 64%, var(--color-cream)) 100%
    );
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 62%, transparent);
    box-shadow: 0 16px 28px color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  .shelf-section {
    position: relative;
    display: flex;
    align-items: flex-end;
    scroll-snap-align: start;
    scroll-margin-inline: 2rem;
  }

  .shelf-section.hidden {
    display: none;
  }

  .shelf-section__label {
    position: absolute;
    bottom: calc(100% + 0.9rem);
    left: 1.25rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* Bookend. Slightly taller than the tallest book so sections read as
     physically separated rather than just spaced. */
  .shelf-divider {
    flex: 0 0 auto;
    width: 7px;
    height: 272px;
    margin-inline: 0.9rem;
    border-radius: 2px 2px 0 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--color-ink) 48%, var(--color-cream)),
      color-mix(in srgb, var(--color-ink) 28%, var(--color-cream))
    );
    box-shadow: 0 8px 16px color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  .shelf-books {
    display: flex;
    align-items: flex-end;
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Light falls off toward the ends of the run. This is where the warmth
     comes from, since the palette contributes no warm hues. */
  .shelf-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(1.25rem, 3.5vw, 3.5rem);
    pointer-events: none;
  }

  .shelf-fade--start {
    left: 0;
    background: linear-gradient(90deg, var(--color-cream), transparent);
  }

  .shelf-fade--end {
    right: 0;
    background: linear-gradient(270deg, var(--color-cream), transparent);
  }

  .shelf-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .shelf-scroller {
      scroll-behavior: auto;
    }
  }

  @media (max-width: 600px) {
    .shelf-run {
      --chip-space: 1.5rem;
      padding-top: 2rem;
    }

    .shelf-divider {
      height: 210px;
    }

    .shelf-books {
      gap: 2px;
    }
  }
</style>

<script>
  // Counts come from a free, keyless counter API. It allows 30 requests per
  // 10 seconds per IP, which is the entire reason for the queue below: the
  // page has two producers (Recently added, plus the shelf) and firing them
  // both unthrottled gets everything 429'd, including the user's own click.
  const API = "https://abacus.jasoncameron.dev";
  const NS = "veryvivid-library";
  const endpoint = (action: "get" | "hit", key: string) => `${API}/${action}/${NS}/${key}`;

  // The counter API 400s on keys longer than 64 characters. Two slugs are long
  // enough that `<slug>-views` overflows, so those fall back to a truncated
  // slug plus a stable hash. Everything shorter keeps its plain key, which
  // matters: changing the scheme wholesale would orphan the counts already
  // recorded against the existing keys.
  function counterKey(slug: string, kind: "views" | "likes") {
    const plain = `${slug}-${kind}`;
    if (plain.length <= 64) return plain;
    let h = 2166136261;
    for (let i = 0; i < slug.length; i++) {
      h ^= slug.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return `${slug.slice(0, 44)}-${(h >>> 0).toString(36)}-${kind}`;
  }
  const likedKey = (slug: string) => `lib-liked:${slug}`;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const esc = (s: string) => (window.CSS && CSS.escape ? CSS.escape(s) : s);

  // ---- shared rate-limited fetch queue ----
  const queue: string[] = [];
  const seen = new Set<string>();
  let draining = false;

  function enqueue(slug: string) {
    if (seen.has(slug)) return;
    seen.add(slug);
    queue.push(slug);
    void drain();
  }

  async function drain() {
    if (draining) return;
    draining = true;
    while (queue.length) {
      await loadCounts(queue.shift()!);
      await sleep(400);
    }
    draining = false;
  }

  function setViews(slug: string, value: number) {
    const label = `${value} ${value === 1 ? "view" : "views"}`;
    document
      .querySelectorAll<HTMLElement>(`.lib-views[data-slug="${esc(slug)}"]`)
      .forEach((el) => (el.textContent = label));
  }

  function setLikes(slug: string, value: number) {
    document
      .querySelectorAll<HTMLElement>(`.lib-like[data-slug="${esc(slug)}"] .lib-like-count`)
      .forEach((el) => (el.textContent = String(value)));
  }

  // Eight decks appear twice on this page (Recently added + the shelf), so
  // every update has to hit all nodes sharing the slug or the copies disagree.
  function markLiked(slug: string) {
    document
      .querySelectorAll<HTMLButtonElement>(`.lib-like[data-slug="${esc(slug)}"]`)
      .forEach((btn) => {
        btn.setAttribute("aria-pressed", "true");
        const icon = btn.querySelector<HTMLElement>(".lib-like-icon");
        if (icon) icon.textContent = "♥";
      });
  }

  // A counter that has never been hit does not exist yet and the API answers
  // 404. That is a real zero, not a failure, so show it as one; only a
  // genuine error leaves the placeholder blank.
  async function loadCounts(slug: string) {
    try {
      const res = await fetch(endpoint("get", counterKey(slug, "views")));
      if (res.ok) setViews(slug, (await res.json()).value);
      else if (res.status === 404) setViews(slug, 0);
    } catch {
      /* counter service is best-effort; leave the placeholder */
    }
    await sleep(400);
    try {
      const res = await fetch(endpoint("get", counterKey(slug, "likes")));
      if (res.ok) setLikes(slug, (await res.json()).value);
    } catch {
      /* same */
    }
  }

  function restoreLikedState() {
    document.querySelectorAll<HTMLButtonElement>(".lib-like").forEach((btn) => {
      const slug = btn.dataset.slug;
      if (slug && localStorage.getItem(likedKey(slug))) markLiked(slug);
    });
  }

  // Recently added is always on screen, so enqueue those immediately; shelf
  // books enqueue themselves as they scroll near view.
  function wireCountProducers() {
    document
      .querySelectorAll<HTMLElement>("#lib-recent [data-slug]")
      .forEach((el) => el.dataset.slug && enqueue(el.dataset.slug));

    const shelf = document.getElementById("lib-shelf");
    if (!shelf) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const slug = (entry.target as HTMLElement).dataset.slug;
          if (slug) enqueue(slug);
          io.unobserve(entry.target);
        }
      },
      { root: shelf, rootMargin: "0px 400px" }
    );

    shelf.querySelectorAll<HTMLElement>(".book[data-slug]").forEach((b) => io.observe(b));
  }

  function wireViewTracking() {
    document.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest<HTMLElement>(
        ".book[data-slug], .lib-thumb-link[data-slug], .lib-title-link[data-slug]"
      );
      const slug = link?.dataset.slug;
      if (slug) fetch(endpoint("hit", counterKey(slug, "views"))).catch(() => {});
    });
  }

  function wireLikeButtons() {
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".lib-like");
      if (!btn) return;
      e.preventDefault();
      const slug = btn.dataset.slug;
      if (!slug || localStorage.getItem(likedKey(slug))) return;

      try {
        const res = await fetch(endpoint("hit", counterKey(slug, "likes")));
        if (!res.ok) return;
        setLikes(slug, (await res.json()).value);
        markLiked(slug);
        localStorage.setItem(likedKey(slug), "1");
      } catch {
        /* leave the button unpressed so it can be retried */
      }
    });
  }

  function wireSearchAndFilters() {
    const search = document.getElementById("lib-search") as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".lib-filter-btn");
    const shelf = document.getElementById("lib-shelf");
    const summary = document.getElementById("lib-summary");
    const noResults = document.getElementById("lib-no-results");
    if (!search || !shelf) return;

    const slots = Array.from(shelf.querySelectorAll<HTMLElement>(".book-slot"));
    const sections = Array.from(shelf.querySelectorAll<HTMLElement>(".shelf-section"));
    const total = slots.length;
    let activeCat = "all";

    function apply() {
      const q = search!.value.toLowerCase().trim();
      let visible = 0;

      slots.forEach((slot) => {
        const catMatch = activeCat === "all" || slot.dataset.category === activeCat;
        const textMatch = !q || slot.dataset.title?.includes(q);
        const show = catMatch && !!textMatch;
        slot.classList.toggle("hidden", !show);
        if (show) visible++;
      });

      // An empty section takes its bookend and label with it.
      sections.forEach((section) => {
        const anyVisible = section.querySelector(".book-slot:not(.hidden)") !== null;
        section.classList.toggle("hidden", !anyVisible);
      });

      if (summary) {
        summary.textContent =
          visible === total ? `Showing all ${total}` : `Showing ${visible} of ${total}`;
      }
      if (noResults) noResults.style.display = visible === 0 ? "block" : "none";
    }

    search.addEventListener("input", apply);

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCat = btn.dataset.cat ?? "all";
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        apply();

        const target =
          activeCat === "all"
            ? shelf!.querySelector(".shelf-section")
            : document.getElementById(`shelf-${activeCat}`);
        target?.scrollIntoView({ inline: "start", block: "nearest" });
      });
    });
  }

  // Tab still reaches every book, no roving tabindex, which would hide 74
  // links from a screen reader. Arrows are purely additive.
  function wireKeyboard() {
    const shelf = document.getElementById("lib-shelf");
    if (!shelf) return;

    shelf.addEventListener("keydown", (e) => {
      const keys = ["ArrowLeft", "ArrowRight", "Home", "End"];
      if (!keys.includes(e.key)) return;

      const books = Array.from(
        shelf.querySelectorAll<HTMLAnchorElement>(".book-slot:not(.hidden) .book")
      );
      if (!books.length) return;

      const current = (e.target as HTMLElement).closest<HTMLAnchorElement>(".book");
      const idx = current ? books.indexOf(current) : -1;

      let next: HTMLAnchorElement | undefined;
      if (e.key === "Home") next = books[0];
      else if (e.key === "End") next = books[books.length - 1];
      else if (e.key === "ArrowLeft") next = books[Math.max(0, idx - 1)];
      else if (e.key === "ArrowRight") next = books[Math.min(books.length - 1, idx + 1)];

      if (next) {
        e.preventDefault();
        next.focus();
      }
    });
  }

  // Touch has no hover, so the first tap reveals the cover and chip and the
  // second tap follows the link.
  function wireTouchPreview() {
    if (!window.matchMedia("(hover: none)").matches) return;
    const shelf = document.getElementById("lib-shelf");
    if (!shelf) return;

    let previewing: HTMLElement | null = null;

    shelf.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest<HTMLElement>(".book");
      if (!link) return;
      const slot = link.closest<HTMLElement>(".book-slot");
      if (!slot || slot === previewing) return;

      e.preventDefault();
      previewing?.classList.remove("is-previewing");
      slot.classList.add("is-previewing");
      previewing = slot;
    });
  }

  restoreLikedState();
  wireCountProducers();
  wireViewTracking();
  wireLikeButtons();
  wireSearchAndFilters();
  wireKeyboard();
  wireTouchPreview();
</script>
